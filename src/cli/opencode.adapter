# ai-cli-terminal adapter: OpenCode
#
# Evidence (re-probed 2026-10-05, local opencode v2.0.23, temp HOME, PTY):
#   * control run: the TUI writes OSC 0 once with the literal `OpenCode`;
#   * OPENCODE_DISABLE_TERMINAL_TITLE=1 and =true: the title is STILL written —
#     the flag string is absent from this build. The flag IS official upstream
#     (anomalyco/opencode packages/core/src/flag/flag.ts:26, gated in
#     packages/tui/src/app.tsx, documented in cli.mdx: "Disable automatic
#     terminal title updates") → exported for forward compatibility and
#     verified INEFFECTIVE on v2.0.23;
#   * OPENCODE_CLI_CONFIG_CONTENT='{"terminal":{"title":false}}':
#     ZERO OSC 0 writes — official per-process inline config
#     (opencode.ai/v2/docs/cli/config § Inline config): merged over
#     ~/.config/opencode/cli.json at startup, the file itself is never written;
#   * on exit the TUI clears the title (setTerminalTitle("")); the wrapper's
#     EXIT restore runs after the child and repaints the project name;
#   * `--standalone` avoids the shared background service (used by tests);
#   * Phase 1 attempts failed because they used the WRONG variable name
#     (OPENCODE_CONFIG_CONTENT) and the WRONG file (tui.json — since
#     migrated to cli.json); recorded here so they are not retried.
#
# Why per-process env beats global config (D10): plain `opencode` must keep
# native behavior; only wrapper-launched runs get `<project> · OPENCODE>`.
# No plugin is involved (the V0 ~/.config/opencode/plugins/marvis-tab-title.ts
# is legacy — migration notes in docs/compatibility.md), and no global
# OpenCode setting is ever written by this project.
#
# Strategy: A (official per-process mechanism). See D9/D10.

ACT_ADAPTER_ID=opencode
ACT_ADAPTER_ALIASES=()
ACT_ADAPTER_DISPLAY=OPENCODE
ACT_ADAPTER_BINS=(opencode)
ACT_ADAPTER_REAL_ENV=ACT_REAL_OPENCODE
ACT_ADAPTER_STRATEGY=env-suppress
ACT_ADAPTER_NOTES='OPENCODE_CLI_CONFIG_CONTENT verified 0 OSC writes (v2.0.23); OPENCODE_DISABLE_TERMINAL_TITLE official upstream, ineffective on v2.0.23'

act::adapter::prepare() {
    # Opt-out parity with the CodeBuddy adapter: keep native CLI behavior.
    [ -z "${ACT_KEEP_CLI_TITLE-}" ] || return 0

    # 1. Official upstream flag (cli.mdx). Builds that do not know it ignore
    #    it; an explicit user value is respected as-is.
    if [ -z "${OPENCODE_DISABLE_TERMINAL_TITLE+x}" ]; then
        export OPENCODE_DISABLE_TERMINAL_TITLE=true
    fi

    # 2. Verified per-process suppression on this build. A non-empty inline
    #    config the user set themselves keeps authority (their settings win).
    if [ -z "${OPENCODE_CLI_CONFIG_CONTENT-}" ]; then
        export OPENCODE_CLI_CONFIG_CONTENT='{"terminal":{"title":false}}'
    fi
}
